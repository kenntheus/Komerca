# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/komerca"

# Server
NODE_ENV=development
PORT=3000

# JWT (use long random strings — min 32 chars each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh

# Image storage: "local" (dev) or "cloudinary" (production)
IMAGE_STORAGE=local

# Cloudinary (required when IMAGE_STORAGE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS provider: "mock" (logs OTP to stdout) or "semaphore" (production)
SMS_PROVIDER=mock
SEMAPHORE_API_KEY=

# AI provider: "mock" (returns canned response) or "claude" (production)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
