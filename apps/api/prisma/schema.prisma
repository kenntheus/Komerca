generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  REMOVED
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  COMPLETED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ReportReason {
  SPAM
  FAKE
  OFFENSIVE
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  REMOVED
}

// ── Users ──────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  phone              String   @unique
  name               String
  avatarUrl          String?
  city               String?
  role               UserRole @default(BUYER)
  completedDealCount Int      @default(0)
  responseRate       Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  otpTokens       OtpToken[]
  refreshTokens   RefreshToken[]
  listings        Listing[]
  reservations    Reservation[]
  offersMade      Offer[]    @relation("OfferBuyer")
  reviews         Review[]   @relation("ReviewAuthor")
  receivedReviews Review[]   @relation("ReviewSeller")
  sentMessages    Message[]
  reports         Report[]   @relation("ReportReporter")
  reportedItems   Report[]   @relation("ReportTarget")
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Categories ─────────────────────────────────────────────────────────────

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  iconName  String
  sortOrder Int    @default(0)

  listings Listing[]
}

// ── Listings ───────────────────────────────────────────────────────────────

model Listing {
  id           String           @id @default(cuid())
  sellerId     String
  categoryId   String
  title        String
  description  String
  price        Decimal          @db.Decimal(10, 2)
  condition    ListingCondition
  city         String
  lat          Float?
  lng          Float?
  attributes   Json
  status       ListingStatus    @default(DRAFT)
  viewCount    Int              @default(0)
  // tsvector column maintained by a DB trigger (see migration SQL); not queryable via Prisma ORM
  searchVector Unsupported("tsvector")?
  checkScore   Float?
  checkLevel   String?
  checkReasons Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  seller      User           @relation(fields: [sellerId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  photos      ListingPhoto[]
  reservation Reservation?
  offers      Offer[]
  inquiries   Inquiry[]
  reviews     Review[]
  reports     Report[]       @relation("ListingReports")

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([price])
  @@index([createdAt])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  url       String
  publicId  String
  dhash     String?
  sortOrder Int     @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([dhash])
}

// ── Deals: Reservations ────────────────────────────────────────────────────

model Reservation {
  id        String            @id @default(cuid())
  listingId String            @unique
  buyerId   String
  expiresAt DateTime
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
}

// ── Deals: Offers ──────────────────────────────────────────────────────────

model Offer {
  id        String      @id @default(cuid())
  listingId String
  buyerId   String
  amount    Decimal     @db.Decimal(10, 2)
  message   String?
  status    OfferStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation("OfferBuyer", fields: [buyerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
}

// ── Deals: Inquiry Threads ─────────────────────────────────────────────────

model Inquiry {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  createdAt DateTime @default(now())

  listing  Listing   @relation(fields: [listingId], references: [id])
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
}

model Message {
  id        String   @id @default(cuid())
  inquiryId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([inquiryId])
}

// ── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  listingId String
  authorId  String
  sellerId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  seller  User    @relation("ReviewSeller", fields: [sellerId], references: [id])

  @@unique([listingId, authorId])
  @@index([sellerId])
}

// ── Reports ────────────────────────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  reporterId String
  listingId  String
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User    @relation("ReportReporter", fields: [reporterId], references: [id])
  listing  Listing @relation("ListingReports", fields: [listingId], references: [id])
  target   User    @relation("ReportTarget", fields: [targetId], references: [id])

  @@index([status])
}

// ── Saved Searches ─────────────────────────────────────────────────────────

model SavedSearch {
  id          String    @id @default(cuid())
  userId      String
  query       String
  filters     Json
  lastAlertAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ── Reference Prices (SAMPLE DATA – not real market prices) ────────────────

model ReferencePrice {
  id       String  @id @default(cuid())
  model    String  @unique
  minPrice Decimal @db.Decimal(10, 2)
  maxPrice Decimal @db.Decimal(10, 2)
  currency String  @default("PHP")
}
